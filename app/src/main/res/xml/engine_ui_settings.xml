<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="engine_ui_settings">

    <androidx.preference.PreferenceCategory
        android:title="@string/engine_proxy"
        app:iconSpaceReserved="false">

        <EditTextPreference
            android:key="engine_max_connections"
            android:title="@string/engine_max_connections_setting"
            android:inputType="number"
            android:defaultValue="512"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:key="engine_buffer_size"
            android:title="@string/engine_buffer_size_setting"
            android:inputType="number"
            android:defaultValue="16384"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

        <CheckBoxPreference
            android:key="engine_no_domain"
            android:title="@string/engine_no_domain_setting"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />

        <CheckBoxPreference
            android:key="engine_tcp_fast_open"
            android:title="@string/engine_tcp_fast_open_setting"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />

    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:title="@string/engine_desync"
        app:iconSpaceReserved="false">

        <ListPreference
            android:key="engine_hosts_mode"
            android:title="@string/engine_hosts_mode_setting"
            android:entries="@array/engine_hosts_modes"
            android:entryValues="@array/engine_hosts_modes_entries"
            android:defaultValue="disable"
            android:summary="%s"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:key="engine_hosts_blacklist"
            android:title="@string/engine_hosts_blacklist_setting"
            android:dialogTitle="@string/engine_hosts_blacklist_setting"
            android:inputType="textMultiLine"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:key="engine_hosts_whitelist"
            android:title="@string/engine_hosts_whitelist_setting"
            android:dialogTitle="@string/engine_hosts_whitelist_setting"
            android:inputType="textMultiLine"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:key="engine_default_ttl"
            android:title="@string/engine_default_ttl_setting"
            android:inputType="number"
            android:defaultValue="0"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:key="engine_desync_method"
            android:title="@string/engine_desync_method_setting"
            android:entries="@array/engine_desync_methods"
            android:entryValues="@array/engine_desync_methods_entries"
            android:defaultValue="oob"
            android:summary="%s"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:key="engine_split_position"
            android:title="@string/engine_split_position_setting"
            android:inputType="numberSigned"
            android:defaultValue="1"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <CheckBoxPreference
            android:key="engine_split_at_host"
            android:title="@string/engine_split_at_host_setting"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />

        <CheckBoxPreference
            android:key="engine_drop_sack"
            android:title="@string/engine_drop_sack_setting"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:key="engine_fake_ttl"
            android:title="@string/engine_fake_ttl_setting"
            android:inputType="number"
            android:defaultValue="8"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:key="engine_fake_offset"
            android:title="@string/engine_fake_offset_setting"
            android:inputType="number"
            android:defaultValue="0"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:key="engine_fake_sni"
            android:title="@string/sni_of_fake_packet"
            android:defaultValue="www.iana.org"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:key="engine_oob_data"
            android:title="@string/oob_data"
            android:defaultValue="a"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:title="@string/engine_protocols_category"
        app:iconSpaceReserved="false">

        <CheckBoxPreference
            android:key="engine_desync_http"
            android:title="@string/desync_http"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />

        <CheckBoxPreference
            android:key="engine_desync_https"
            android:title="@string/desync_https"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />

        <CheckBoxPreference
            android:key="engine_desync_udp"
            android:title="@string/desync_udp"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />

    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:title="@string/desync_http_category"
        app:iconSpaceReserved="false">

        <CheckBoxPreference
            android:key="engine_host_mixed_case"
            android:title="@string/engine_host_mixed_case_setting"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />

        <CheckBoxPreference
            android:key="engine_domain_mixed_case"
            android:title="@string/engine_domain_mixed_case_setting"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />

        <CheckBoxPreference
            android:key="engine_host_remove_spaces"
            android:title="@string/engine_host_remove_spaces_setting"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />

    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:title="@string/desync_https_category"
        app:iconSpaceReserved="false">

        <CheckBoxPreference
            android:key="engine_tlsrec_enabled"
            android:title="@string/engine_tlsrec_enabled_setting"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:key="engine_tlsrec_position"
            android:title="@string/engine_tlsrec_position_setting"
            android:inputType="numberSigned"
            android:defaultValue="0"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

        <CheckBoxPreference
            android:key="engine_tlsrec_at_sni"
            android:title="@string/engine_tlsrec_at_sni_setting"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />

    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:title="@string/desync_udp_category"
        app:iconSpaceReserved="false">

        <EditTextPreference
            android:key="engine_udp_fake_count"
            android:title="@string/engine_udp_fake_count"
            android:inputType="number"
            android:defaultValue="1"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />

    </androidx.preference.PreferenceCategory>

</PreferenceScreen>
