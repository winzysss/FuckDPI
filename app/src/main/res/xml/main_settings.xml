<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:tag="main_settings">

    <androidx.preference.PreferenceCategory
        android:title="@string/general_category">

        <ListPreference
            android:key="language"
            android:icon="@drawable/ic_language"
            android:title="@string/lang_settings"
            android:entries="@array/languages"
            android:entryValues="@array/languages_entries"
            android:summary="%s"
            android:defaultValue="system" />

        <ListPreference
            android:key="app_theme"
            android:icon="@drawable/ic_palette"
            android:title="@string/theme_settings"
            android:entries="@array/themes"
            android:entryValues="@array/themes_entries"
            android:summary="%s"
            android:defaultValue="system" />

    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:title="@string/automation">

        <SwitchPreference
            android:key="autostart"
            android:icon="@drawable/ic_power"
            android:title="@string/autostart_settings"
            android:defaultValue="false" />

        <SwitchPreference
            android:key="auto_connect"
            android:icon="@drawable/ic_autorenew"
            android:title="@string/autoconnect_settings"
            android:defaultValue="false" />

        <SwitchPreference
            android:key="auto_strategy"
            android:icon="@drawable/ic_speed"
            android:title="@string/auto_strategy"
            android:summary="@string/auto_strategy_summary"
            android:defaultValue="true" />

    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:title="@string/permission_category">

        <Preference
            android:key="battery_optimization"
            android:icon="@drawable/ic_battery"
            android:title="@string/battery_optimization"
            android:summary="@string/battery_optimization_summary">
        </Preference>

        <Preference
            android:key="storage_access"
            android:icon="@drawable/ic_folder"
            android:title="@string/storage_access"
            android:summary="@string/storage_access_summary">
        </Preference>

    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:title="@string/about_category">

        <Preference
            android:key="source_code"
            android:title="@string/source_code_link"
            android:icon="@drawable/ic_github">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://github.com/winzysss/FuckDPI" />
        </Preference>

        <Preference
            android:key="documentation"
            android:icon="@drawable/ic_documentation"
            android:title="@string/documentation_link">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://github.com/winzysss/FuckDPI#readme" />
        </Preference>

        <SwitchPreference
            android:key="update_check_enabled"
            android:icon="@drawable/ic_autorenew"
            android:title="@string/update_check_enabled"
            android:summary="@string/update_check_summary"
            android:defaultValue="true" />

        <Preference
            android:key="update_check_now"
            android:icon="@drawable/ic_autorenew"
            android:title="@string/update_check_now" />

        <Preference
            android:key="version"
            android:icon="@drawable/ic_info"
            android:title="@string/version"
            app:useSimpleSummaryProvider="true"
            tools:summary="1.0.0" />

        <Preference
            android:key="engine_version"
            android:icon="@drawable/ic_info"
            android:title="@string/engine_version"
            app:useSimpleSummaryProvider="true"
            android:summary="0.0.1" />

    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:title="@string/advanced_category">

        <ListPreference
            android:key="engine_mode"
            android:icon="@drawable/ic_vpn_key"
            android:title="@string/mode_setting"
            android:entries="@array/engine_modes"
            android:entryValues="@array/engine_modes_entries"
            android:summary="%s"
            android:defaultValue="vpn" />

        <Preference
            android:key="dns_ip_picker"
            android:icon="@drawable/ic_dns"
            android:title="@string/dbs_ip_setting" />

        <Preference
            android:key="private_dns"
            android:icon="@drawable/ic_dns"
            android:title="@string/private_dns"
            android:persistent="false"
            app:isPreferenceVisible="false" />

        <EditTextPreference
            android:key="dns_ip"
            android:title="@string/dbs_ip_setting"
            android:defaultValue="1.1.1.1" />

        <SwitchPreference
            android:key="ipv6_enable"
            android:icon="@drawable/ic_network"
            android:title="@string/ipv6_setting"
            android:defaultValue="false" />

        <ListPreference
            android:key="applist_type"
            android:icon="@drawable/ic_filter_list"
            android:title="@string/applist_setting"
            android:entries="@array/applist_types"
            android:entryValues="@array/applist_types_entries"
            android:summary="%s"
            android:defaultValue="disable" />

        <Preference
            android:key="selected_apps"
            android:icon="@drawable/ic_apps"
            android:title="@string/apps_select"
            app:fragment="io.github.winzysss.fuckdpi.fragments.AppSelectionFragment" />

        <SwitchPreference
            android:key="engine_enable_cmd_settings"
            android:icon="@drawable/ic_terminal"
            android:title="@string/use_command_line_settings"
            android:defaultValue="true" />

        <Preference
            android:key="engine_ui_settings"
            android:icon="@drawable/ic_tune"
            android:title="@string/ui_editor"
            app:useSimpleSummaryProvider="true"
            app:fragment="io.github.winzysss.fuckdpi.fragments.UiSettingsFragment" />

        <Preference
            android:key="engine_cmd_settings"
            android:icon="@drawable/ic_code"
            android:title="@string/command_line_editor"
            app:useSimpleSummaryProvider="true"
            app:fragment="io.github.winzysss.fuckdpi.fragments.CmdSettingsFragment" />

        <Preference
            android:key="proxy_test"
            android:icon="@drawable/ic_speed"
            android:title="@string/title_test"
            android:summary="@string/summary_test"/>

        <EditTextPreference
            android:key="engine_proxy_ip"
            android:icon="@drawable/ic_computer"
            android:title="@string/engine_proxy_ip_setting"
            android:defaultValue="127.0.0.1"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:key="engine_proxy_port"
            android:icon="@drawable/ic_port"
            android:title="@string/engine_proxy_port_setting"
            android:inputType="number"
            android:defaultValue="1080"
            app:useSimpleSummaryProvider="true" />

    </androidx.preference.PreferenceCategory>

</PreferenceScreen>
